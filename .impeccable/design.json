  "narrative": {
    "northStar": "Mapbox",
    "overview": "The user-selected Mapbox world gives this workspace its dark layered surfaces, blue actions, pill controls and quiet geometric type character. The light theme keeps the same hierarchy and control language. Color makes selection legible while hotel facts and their sources carry the content.\n\nThe implemented interface is a full-width working surface with rounded panels, a results rail and a geographic scene. Its depth comes from solid surface tones and fine borders. Empty, unavailable and unknown information remain visibly different states; the map never supplies decorative replacement data.",
    "keyCharacteristics": [
      "Layered neutral surfaces with blue actions and geographic selection.",
      "Rounded content panels and pill-shaped actions.",
      "Compact readable typography in RU and EN.",
      "API-backed facts, geometry and explicit unavailable states."
    ],
    "rules": [
      {
        "name": "The Semantic Roles Rule",
        "body": "Components read semantic tokens; the light and dark themes assign their values. Blue identifies actions, focus and geographic selection. Status always includes text or an icon.",
        "section": "colors"
      },
      {
        "name": "The Available Font Rule",
        "body": "Cera Pro names the intended family, but no licensed Cera Pro files are supplied or downloaded. The sans stack falls back to the local system; preserve this fallback rather than assuming the font is installed.",
        "section": "typography"
      },
      {
