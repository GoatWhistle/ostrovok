"name":"Удобства для пляжа","free":false},{"name":"Развлечения на воде","free":false},{"name":"Полотенца для пляжа/бассейна","free":false},{"name":"Открытый бассейн с подогревом","free":false}]},{"name":"Бизнес","amenities":[{"name":"Бизнес-центр","free":false},{"name":"Ксерокс","free":false},{"name":"Организация встреч и банкетов","free":false},{"name":"Конференц-зал","free":false}]},{"name":"Спорт","amenities":[{"name":"Дайвинг","free":false},{"name":"Настольный теннис","free":false},{"name":"Сноркелинг","free":false},{"name":"Теннисный корт","free":false},{"name":"Фитнес-центр","free":false},{"name":"Тренажерный зал","free":false}]},{"name":"Красота и здоровье","amenities":[{"name":"Баня","free":false},{"name":"Массаж","free":true},{"name":"Салон красоты","free":true},{"name":"Сауна","free":false},{"name":"Спа-центр","free":true},{"name":"Хаммам","free":false},{"name":"Дежурный врач","free":false}]},{"name":"Дети","amenities":[{"name":"Игровая комната","free":false},{"name":"Детская игровая площадка","free":false},{"name":"Детский бассейн","free":false},{"name":"Детский клуб","free":false}]},{"name":"Животные","amenities":[{"name":"Размещение с домашними животными","free":true}]},{"name":"Санитарные меры","amenities":[{"name":"Усиленные меры дезинфекции","free":true}]}],"description":[{"title":"Расположение","paragraphs":["Гостиничный Комплекс «Жемчужина» находится в Сочи. Этот отель расположен в пешей доступности от центра города. Рядом с отелем можно прогуляться. Неподалёку: Приморский пляж, Зимний театр и пляж Солнечный."]},{"title":"В отеле","paragraphs":["Скоротать вечер или провести время перед сном можно в баре. Для гостей работает ресторан и кафе. На территории работает бесплатный Wi-Fi.","Среди услуг для красоты и здоровья — массажный кабинет, сауна, паровая баня и спа-центр. Спортивные гости оценят фитнес-центр, тренажёрный зал и настольный теннис.","На территории есть пинг-понг. В данном отеле имеется открытый подогреваемый бассейн. Можно организовать деловую встречу, переговоры и даже собеседование. Для этого предусмотрены бизнес-центр и специальное оборудование. В отеле есть игровые детские комнаты.","Чтобы забронировать экскурсию, можно обратиться в экскурсионное бюро отеля. Чтобы путешествие было не только приятным, но и удобным, гости могут заказать трансфер. Доступная среда: работает лифт. Дополнительно: прачечная, химчистка, банкомат, индивидуальная регистрация заезда и отъезда, гладильные услуги, прокат автомобилей, сейф и консьерж.","Сотрудники отеля поддержат беседу на английском и русском."]},{"title":"В номере","paragraphs":["В номере есть душ, телевизор, мини-бар, халат и тапочки. Перечисленные услуги есть не во всех номерах."]}],"nearby":[{"name":"Пляж Жемчужина","distance_m":168,"kind":"BEACH"},{"name":"Зимний театр","distance_m":242,"kind":"CONCERTS_AND_PERFORMANCES"},{"name":"Пляж Цирк","distance_m":335,"kind":"BEACH"},{"name":"Пляж Санремо","distance_m":507,"kind":"BEACH"},{"name":"Пляж Приморский","distance_m":558,"kind":"BEACH"},{"name":"Пляж Дель Мар","distance_m":753,"kind":"BEACH"},{"name":"Пляж Мориса Тореза","distance_m":892,"kind":"BEACH"},{"name":"Сочинский дендрарий","distance_m":947,"kind":"PARK"},{"name":"Пляж Маяк","distance_m":988,"kind":"BEACH"},{"name":"Концертный зал Фестивальный","distance_m":1228,"kind":"CONCERTS_AND_PERFORMANCES"},{"name":"Пляж отеля Лучано Сочи","distance_m":1395,"kind":"BEACH"},{"name":"Порт Сочи","distance_m":1572,"kind":"HARBOR"}],"rating":{"total":7.9,"reviews_count":302,"detailed":[{"name":"cleanness","score":7.7},{"name":"hygiene","score":7.6},{"name":"location","score":9.4},{"name":"meal","score":7.2},{"name":"price","score":7.3},{"name":"room","score":7.1},{"name":"services","score":7.6},{"name":"wifi","score":8.1}]},"check_in_from":"15:00","check_out_until":"12:00","email":"ibookings@zhem.ru","phone":"+78622661188"}}