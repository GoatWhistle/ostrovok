diff --git a/frontend/tests/features/hotel-search/workspace-consultation.test.tsx b/frontend/tests/features/hotel-search/workspace-consultation.test.tsx
new file mode 100644
index 0000000..fe9432e
--- /dev/null
+++ b/frontend/tests/features/hotel-search/workspace-consultation.test.tsx
@@ -0,0 +1,68 @@
+import { act, renderHook } from "@testing-library/react"
+import { beforeEach, describe, expect, it, vi } from "vitest"
+import type { Conversation } from "../../../src/features/hotel-search/use-conversation"
+import { useHotelWorkspace } from "../../../src/features/hotel-search/use-hotel-workspace"
+import type { MatchedProperty, SearchResult } from "../../../src/shared/api/hotel-types"
+
+const harness = vi.hoisted(() => ({
+  answer: (_data: Conversation) => {},
+  data: undefined as Conversation | undefined,
+}))
+vi.mock("../../../src/features/hotel-search/use-conversation", () => ({
+  useConversation: (_selected: string | undefined, onAnswer: (data: Conversation) => void) => {
+    harness.answer = onAnswer
+    return { data: harness.data, history: [], conversationId: "conversation" }
+  },
+}))
+
+const result: SearchResult = {
+  hotel: { id: "h1", name: "Hotel", location: [39.72, 43.58] },
+  matched: [],
+  score: 0,
+}
+const property = {
+  characteristic_key: "view",
+  match: "partial",
+  geo_refs: ["g_point"],
+} as MatchedProperty
+function reply(searchMessageId: string): Conversation {
+  return {
+    id: "conversation",
+    title: "Hotels",
+    updated_at: null,
+    messages: [
+      {
+        id: "new-answer",
+        role: "assistant",
+        content: "Advice",
+        created_at: "2026-10-26T09:00:00Z",
+      },
+    ],
+    search_message_id: searchMessageId,
+    search: { query_id: "q", parsed: {}, results: [result] },
+  }
+}
+
+beforeEach(() => {
+  harness.data = undefined
+})
+describe("consultation in the hotel workspace", () => {
+  it("keeps the selected hotel and focused map property when advice preserves the search", () => {
+    const state = renderHook(() => useHotelWorkspace())
+    act(() => state.result.current.property(result, property))
+    expect(state.result.current.hotelId).toBe("h1")
+    act(() => harness.answer(reply("old-search-answer")))
+    expect(state.result.current.hotelId).toBe("h1")
+    expect(state.result.current.focusProperty).toBe(property)
+    expect(state.result.current.geoRefs).toEqual(["g_point"])
+  })
+  it("updates selection after an actual new search", () => {
+    const state = renderHook(() => useHotelWorkspace())
+    act(() => state.result.current.property(result, property))
+    const data = reply("new-answer")
+    data.search = { query_id: "new", parsed: {}, results: [] }
+    act(() => harness.answer(data))
+    expect(state.result.current.hotelId).toBeUndefined()
+    expect(state.result.current.focusProperty).toBeUndefined()
+  })
+})
diff --git a/frontend/tests/features/search-chat/consultation.test.tsx b/frontend/tests/features/search-chat/consultation.test.tsx
new file mode 100644
index 0000000..35ba8dd
--- /dev/null
+++ b/frontend/tests/features/search-chat/consultation.test.tsx
@@ -0,0 +1,72 @@
+import { render, screen, within } from "@testing-library/react"
+import { afterEach, expect, it, vi } from "vitest"
+import { SearchChat, type SearchChatProps } from "../../../src/features/search-chat/search-chat"
+import { createI18n, LocaleProvider } from "../../../src/shared/i18n"
+
+const props: SearchChatProps = {
+  messages: [
+    {
+      id: "search-answer",
+      role: "assistant",
+      content: "Found hotels",
+      created_at: "2026-10-26T09:00:00Z",
+    },
+    {
+      id: "consult-answer",
+      role: "assistant",
+      content: "Advice about your trip",
+      created_at: "2026-10-26T09:01:00Z",
+    },
+  ],
+  conversationId: "conversation",
+  history: [],
+  view: "chat",
+  outgoing: undefined,
+  searchMessageId: "search-answer",
+  search: {
+    query_id: "q",
+    parsed: { location_hint: "Sochi" },
+    results: [
+      { hotel: { id: "h1", name: "Hotel", location: [39.72, 43.58] }, score: 1, matched: [] },
+    ],
+  },
+  loading: false,
+  sending: false,
+  failed: false,
+  onSend: vi.fn(),
+  onRetry: vi.fn(),
+  onShowOnMap: vi.fn(),
+  onShowList: vi.fn(),
+  onReset: vi.fn(),
+  onOpenConversation: vi.fn(),
+  onView: vi.fn(),
+  onRename: vi.fn(),
+  onDelete: vi.fn(),
+}
+afterEach(() => vi.unstubAllGlobals())
+it.each(["ru", "en"] as const)(
+  "keeps search controls on the search reply after consultation (%s)",
+  (locale) => {
+    vi.stubGlobal(
+      "ResizeObserver",
+      class {
+        observe() {}
+        disconnect() {}
+      },
+    )
+    const instance = createI18n()
+    void instance.changeLanguage(locale)
+    render(
+      <LocaleProvider instance={instance}>
+        <SearchChat {...props} />
+      </LocaleProvider>,
+    )
+    const search = screen.getByText("Found hotels").closest("li")
+    const advice = screen.getByText("Advice about your trip").closest("li")
+    expect(search).not.toBeNull()
+    expect(advice).not.toBeNull()
+    if (!search || !advice) throw new Error("Chat messages are missing")
+    expect(within(search).getAllByRole("button").length).toBeGreaterThan(0)
+    expect(within(advice).queryByRole("button")).toBeNull()
+  },
+)
