+from dataclasses import replace
+from datetime import datetime
+
+from hotel_agent.application.agent.data_evidence import materialize
+from hotel_agent.application.agent.data_records import DataCriterion, ExplorationOutcome
+from hotel_agent.application.agent.data_tools import DataTools
+from hotel_agent.application.agent.measurement_scope import verify_measurement_scope
+from hotel_agent.application.agent.wish_evidence import relabel_facts, wish_intent
+from hotel_agent.application.ports.llm import LLMPort
+
+
+async def evaluate_criteria(
+    llm: LLMPort,
+    query: str,
+    term: str,
+    criteria: tuple[DataCriterion, ...],
+    tools: DataTools,
+    now: datetime,
+) -> tuple[ExplorationOutcome, tuple[str, ...]]:
+    accepted, rejected = await verify_measurement_scope(llm, query, criteria, tools, now)
+    candidate = materialize(query, (term,), accepted, tools, now, None)
+    if candidate.intents:
+        candidate = replace(
+            candidate,
+            facts=relabel_facts(term, candidate.facts),
+            intents=(wish_intent(term, any(c.required for c in accepted)),),
+        )
+    return candidate, rejected
diff --git a/backend/src/hotel_agent/application/agent/wish_evidence.py b/backend/src/hotel_agent/application/agent/wish_evidence.py
new file mode 100644
index 0000000..2f05625
--- /dev/null
+++ b/backend/src/hotel_agent/application/agent/wish_evidence.py
@@ -0,0 +1,159 @@
+import hashlib
+from collections.abc import Sequence
+from dataclasses import replace
+from datetime import datetime, timedelta
+
+from hotel_agent.application.agent.wish_records import WishResult
+from hotel_agent.application.dto import SearchFactRecord, SearchHotelRecord
+from hotel_agent.application.fact_records import fact_from_record
+from hotel_agent.application.ports.requested_evidence import RequestedEvidence
+from hotel_agent.domain.characteristics import Op
+from hotel_agent.domain.query import Intent
+from hotel_agent.domain.services.scoring import MatchQuality, match
+
+
+def wish_key(term: str) -> str:
+    return "derived:" + hashlib.sha256(("wish@1:" + term).encode()).hexdigest()[:12]
+
+
+def wish_intent(term: str, required: bool = False) -> Intent:
+    return Intent(
+        characteristic_key=wish_key(term),
+        op=Op.EQ,
+        value=True,
+        weight=1,
+        required=required,
+        source_text=term,
+    )
+
+
+def native_facts(
+    term: str, evidence: RequestedEvidence, now: datetime
+) -> tuple[SearchFactRecord, ...]:
+    intents = tuple(i for i in evidence.intents if not i.characteristic_key.startswith("facility:"))
+    result: list[SearchFactRecord] = []
+    ranks = {
+        MatchQuality.FULL: 3,
+        MatchQuality.PARTIAL: 2,
+        MatchQuality.NONE: 1,
+        MatchQuality.UNKNOWN: 0,
+    }
+    for index, intent in enumerate(intents):
+        selected: dict[str, tuple[int, int, float, SearchFactRecord]] = {}
+        for row in evidence.facts:
+            if row.characteristic_key != intent.characteristic_key:
+                continue
+            fact = fact_from_record(row)
+            matched = match(intent, fact, now)
+            unrestricted = match(intent, replace(fact, qualifiers={}), now)
+            rank = (ranks[matched.quality], ranks[unrestricted.quality], row.confidence)
+            if row.hotel_id in selected and rank <= selected[row.hotel_id][:3]:
+                continue
+            value = (
+                True
+                if matched.quality in {MatchQuality.FULL, MatchQuality.PARTIAL}
+                else False
+                if matched.quality is MatchQuality.NONE
+                else None
+            )
+            qualifiers = {
+                **row.qualifiers,
+                "source_text": term,
+                "native_characteristic_key": row.characteristic_key,
+                "native_value": row.value,
+                "native_unit": row.unit,
+                "native_op": str(intent.op),
+                "native_threshold": intent.value,
+            }
+            if matched.quality is MatchQuality.PARTIAL:
+                qualifiers["estimated_match"] = True
+            selected[row.hotel_id] = (
+                rank[0],
+                rank[1],
+                rank[2],
+                replace(
+                    row,
+                    characteristic_key=str(index),
+                    value=value,
+                    unit=None,
+                    qualifiers=qualifiers,
+                ),
+            )
+        result.extend(row for _, _, _, row in selected.values())
+    return relabel_facts(term, result, {str(i) for i in range(len(intents))})
+
+
+def unresolved_facts(
+    result: WishResult,
+    hotels: Sequence[SearchHotelRecord],
+    now: datetime,
+) -> tuple[SearchFactRecord, ...]:
+    return tuple(
+        SearchFactRecord(
+            hotel_id=hotel.id,
+            id=f"f_wish_{wish_key(result.term)[8:]}_{hotel.id}",
+            characteristic_key=wish_key(result.term),
+            value=None,
+            unit=None,
+            qualifiers={
+                "source_text": result.term,
+                "wish_status": result.status,
+                "checked_sources": list(result.checked_sources),
+                "tool_calls": result.tool_calls,
+            },
+            source_type="computed",
+            source_id=None,
+            method="wish_agent@1",
+            confidence=0.2,
+            computed_at=now,
+            valid_until=now + timedelta(minutes=10),
+            status="active",
+            geo_refs=(),
+            explanation=result.reason,
+            facade_azimuth=None,
+        )
+        for hotel in hotels
+    )
+
+
+def relabel_facts(
+    term: str,
+    rows: Sequence[SearchFactRecord],
+    required_keys: set[str] | None = None,
+) -> tuple[SearchFactRecord, ...]:
+    keys = required_keys if required_keys is not None else {row.characteristic_key for row in rows}
+    grouped: dict[str, dict[str, SearchFactRecord]] = {}
+    for row in rows:
+        grouped.setdefault(row.hotel_id, {})[row.characteristic_key] = row
+    result: list[SearchFactRecord] = []
+    for hotel_id, by_key in grouped.items():
+        selected = tuple(by_key.values())
+        value = (
+            False
+            if any(row.value is False for row in selected)
+            else None
+            if not keys <= by_key.keys() or any(row.value is None for row in selected)
+            else True
+        )
+        first = next((row for row in selected if row.value is value), selected[0])
+        result.append(
+            replace(
+                first,
+                id=f"f_wish_{wish_key(term)[8:]}_{hotel_id}",
+                characteristic_key=wish_key(term),
+                value=value,
+                confidence=min(row.confidence for row in selected),
+                geo_refs=tuple(dict.fromkeys(ref for row in selected for ref in row.geo_refs)),
+                explanation="; ".join(dict.fromkeys(row.explanation for row in selected)),
+                qualifiers={
+                    **first.qualifiers,
+                    "source_text": term,
+                    **(
+                        {"estimated_match": True}
+                        if any(row.qualifiers.get("estimated_match") for row in selected)
+                        else {}
+                    ),
+                },
+            )
+        )
+    return tuple(result)
diff --git a/backend/src/hotel_agent/application/agent/wish_ledger.py b/backend/src/hotel_agent/application/agent/wish_ledger.py
new file mode 100644
index 0000000..41539c8
--- /dev/null
+++ b/backend/src/hotel_agent/application/agent/wish_ledger.py
@@ -0,0 +1,79 @@
+import json
+from collections import Counter
+from collections.abc import Mapping
+from dataclasses import dataclass, field
+from typing import Any
+
+SOURCES = {
+    "search_events": "web",
+    "read_event_page": "web",
+    "observe_wildlife": "geography",
+    "measure_landcover": "geography",
+    "check_requested": "database",
+    "read_records": "database",
+    "inspect_data": "database",
+    "search_documents": "embeddings",
+    "get_provider_content": "provider",
+    "get_room_offers": "provider",
+    "search_web": "web",
+    "read_web_page": "web",
+    "measure_terrain": "geography",
+    "measure_geometry": "geography",
+    "find_hotels": "geography",
+    "assess_view": "geography",
+    "get_weather": "environment",
+    "calculate_sun": "environment",
+}
+
+
+@dataclass
+class WishLedger:
+    available: Mapping[str, bool]
+    checked: set[str] = field(default_factory=set)
+    unavailable: set[str] = field(default_factory=set)
+    pending_pages: dict[str, int] = field(default_factory=dict)
+    calls: dict[str, dict[str, Any]] = field(default_factory=dict)
+    duplicates: int = 0
+    finishes: Counter[str] = field(default_factory=Counter)
+
+    def repeated_finish(self, signature: str) -> bool:
+        self.finishes[signature] += 1
+        return self.finishes[signature] >= 3
+
+    def identity(self, action: str, arguments: dict[str, Any]) -> str:
+        return json.dumps([action, arguments], sort_keys=True, ensure_ascii=False)
+
+    def observe(self, action: str, arguments: dict[str, Any], result: dict[str, Any]) -> None:
+        self.calls[self.identity(action, arguments)] = result
+        dataset = str(arguments.get("dataset", ""))
+        source = (
+            "embeddings"
+            if dataset == "retrieved_documents"
+            else "provider"
+            if dataset.startswith("provider_")
+            else "web"
+            if dataset == "web_documents"
+            else SOURCES.get(action, "database")
+        )
+        self.checked.update(
+            name for name in result.get("checked_sources", ()) if name in self.available
+        )
+        if result.get("unavailable") or ("unavailable" in str(result.get("error", "")).lower()):
+            self.checked.add(source)
+            self.unavailable.add(source)
+        elif (
+            not result.get("error")
+            and not result.get("needs_input")
+            and action not in {"inspect_data", "list_candidates"}
+            and (action != "check_requested" or result.get("record_count", 0) > 0)
+        ):
+            self.checked.add(source)
+        if action == "match_records" and not result.get("error"):
+            if result.get("has_more"):
+                self.pending_pages[dataset] = int(result["next_offset"])
+            else:
+                self.pending_pages.pop(dataset, None)
+
+    def missing(self, irrelevant: tuple[str, ...]) -> tuple[str, ...]:
+        required = {name for name, enabled in self.available.items() if enabled}
+        return tuple(sorted(required - self.checked - set(irrelevant)))
diff --git a/backend/src/hotel_agent/application/agent/wish_loop.py b/backend/src/hotel_agent/application/agent/wish_loop.py
new file mode 100644
index 0000000..5b9a7e1
--- /dev/null
+++ b/backend/src/hotel_agent/application/agent/wish_loop.py
@@ -0,0 +1,211 @@
+import asyncio
+from dataclasses import replace
+from typing import Any
+
+from hotel_agent.application.agent.data_evidence import materialize
+from hotel_agent.application.agent.data_records import DataCheck, DataCriterion, ExplorationOutcome
+from hotel_agent.application.agent.data_tools import DataTools
+from hotel_agent.application.agent.wish_context import wish_context
+from hotel_agent.application.agent.wish_criteria import evaluate_criteria
+from hotel_agent.application.agent.wish_evidence import relabel_facts, wish_intent
+from hotel_agent.application.agent.wish_ledger import WishLedger
+from hotel_agent.application.agent.wish_outcomes import WishCompletion
+from hotel_agent.application.agent.wish_records import WishStatus
+from hotel_agent.application.ports.clock import ClockPort
+from hotel_agent.application.ports.llm import LLMPort
+from hotel_agent.application.ports.log import LoggerPort
+from hotel_agent.domain.errors import ModelFailure
+
+
+class WishLoop:
+    def __init__(
+        self,
+        llm: LLMPort,
+        clock: ClockPort,
+        logger: LoggerPort,
+        max_steps: int = 32,
+        timeout_s: float = 180,
+    ) -> None:
+        self._llm, self._clock, self._logger = llm, clock, logger
+        self._max_steps, self._timeout = max_steps, timeout_s
+
+    async def run(self, query: str, term: str, tools: DataTools) -> ExplorationOutcome:
+        ledger = WishLedger(tools.sources)
+        completion = WishCompletion(self._clock, self._logger, term, ledger, tools)
+        observations: list[dict[str, Any]] = []
+        retained = ExplorationOutcome(hotels=tools.hotels, bbox=tools.bbox)
+        reason = "Поиск пожелания не завершён; это не означает отсутствие подходящих отелей."
+        status = WishStatus.INCOMPLETE
+        question = None
+        try:
+            async with asyncio.timeout(self._timeout):
+                if tools.has_native:
+                    result = await tools.execute("check_requested", {"term": term})
+                    ledger.observe("check_requested", {"term": term}, result)
+                    observations.append(
+                        {"tool": "check_requested", "arguments": {"term": term}, "result": result}
+                    )
+                    rows = tools.native_facts.get(term, ())
+                    if rows:
+                        retained = ExplorationOutcome(
+                            hotels=tools.hotels,
+                            bbox=tools.bbox,
+                            intents=(wish_intent(term, tools.native_required.get(term, False)),),
+                            facts=rows,
+                        )
+                        if any(row.value is True for row in rows):
+                            status, reason = (
+                                WishStatus.MATCHED,
+                                "Пожелание подтверждено проверенными данными.",
+                            )
+                            return completion.finish(status, reason, retained, None)
+                else:
+                    observations.append(
+                        {
+                            "tool": "inspect_data",
+                            "arguments": {},
+                            "result": await tools.execute("inspect_data", {}),
+                        }
+                    )
+                for index in range(self._max_steps):
+                    context = wish_context(
+                        query,
+                        term,
+                        tools,
+                        ledger,
+                        observations,
+                        self._max_steps - index,
+                        self._clock.now(),
+                    )
+                    step = await self._llm.explore_data(context)
+                    self._logger.info(
+                        "wish_agent_step", wish=term, step=index + 1, action=step.action
+                    )
+                    if step.action == "finish" and ledger.repeated_finish(repr(step)):
+                        reason = "Агент повторяет необоснованное завершение; проверка не завершена."
+                        break
+                    if step.criteria:
+                        candidate, rejected = await evaluate_criteria(
+                            self._llm, query, term, step.criteria, tools, self._clock.now()
+                        )
+                        if candidate.intents:
+                            retained = candidate
+                        if any(row.value is True for row in retained.facts):
+                            return completion.finish(
+                                WishStatus.MATCHED,
+                                "Пожелание подтверждено источниками.",
+                                retained,
+                                None,
+                            )
+                        if rejected or (step.criteria and not candidate.intents):
+                            observations.append(
+                                {
+                                    "tool": "validate_criteria",
+                                    "result": {
+                                        "error": "Checks do not establish this wish; use returned fields and their actual scope.",
+                                        "fields": tools.descriptions,
+                                    },
+                                }
+                            )
+                            if step.action == "finish":
+                                continue
+                    if step.action == "finish":
+                        if step.question:
+                            return completion.finish(
+                                WishStatus.NEEDS_INPUT,
+                                step.reason
+                                or "Для проверки пожелания требуется уточнение пользователя.",
+                                retained,
+                                step.question,
+                            )
+                        missing = ledger.missing(step.irrelevant_sources)
+                        if (
+                            missing
+                            or ledger.pending_pages
+                            or len(step.reason.strip()) < 12
+                            or not ledger.checked
+                        ):
+                            observations.append(
+                                {
+                                    "tool": "validate_completion",
+                                    "result": {
+                                        "error": "No match yet. Check remaining relevant sources or explain why they cannot establish this wish. Unread pages cannot count as exhausted.",
+                                        "missing_sources": missing,
+                                        "pending_pages": ledger.pending_pages,
+                                    },
+                                }
+                            )
+                            continue
+                        status = (
+                            WishStatus.UNAVAILABLE if ledger.unavailable else WishStatus.EXHAUSTED
+                        )
+                        return completion.finish(status, step.reason, retained, None)
+                    identity = ledger.identity(step.action, step.arguments)
+                    if identity in ledger.calls:
+                        ledger.duplicates += 1
+                        observations.append(
+                            {
+                                "tool": step.action,
+                                "result": {
+                                    "error": "Identical call already returned these data. Choose a new query/source or justify completion.",
+                                    "previous": ledger.calls[identity],
+                                },
+                            }
+                        )
+                        if ledger.duplicates >= 3:
+                            reason = "Агент повторял одинаковые действия и не завершил проверку пожелания."
+                            break
+                        continue
+                    try:
+                        result = await tools.execute(step.action, step.arguments)
+                    except (ValueError, TypeError, KeyError) as error:
+                        result = {"error": str(error)}
+                    except ModelFailure as error:
+                        result = {"unavailable": True, "error": str(error)}
+                    ledger.observe(step.action, step.arguments, result)
+                    observations.append(
+                        {"tool": step.action, "arguments": step.arguments, "result": result}
+                    )
+                    if step.action == "match_records" and result.get("matched_record_count", 0) > 0:
+                        criterion = DataCriterion(
+                            term=term,
+                            source_text=term,
+                            checks=(DataCheck(field=str(result["field"]), op="gte", value=1),),
+                            required=tools.native_required.get(term, False),
+                            explanation="Смысл пожелания подтверждён цитатой источника.",
+                        )
+                        candidate = materialize(
+                            query, (term,), (criterion,), tools, self._clock.now(), None
+                        )
+                        if any(row.value is True for row in candidate.facts):
+                            retained = replace(
+                                candidate,
+                                facts=relabel_facts(term, candidate.facts),
+                                intents=(wish_intent(term, criterion.required),),
+                            )
+                            return completion.finish(
+                                WishStatus.MATCHED,
+                                "Смысл пожелания подтверждён цитатой источника.",
+                                retained,
+                                None,
+                            )
+                    if step.criteria:
+                        candidate, _ = await evaluate_criteria(
+                            self._llm, query, term, step.criteria, tools, self._clock.now()
+                        )
+                        if candidate.intents:
+                            retained = candidate
+                        if any(row.value is True for row in retained.facts):
+                            return completion.finish(
+                                WishStatus.MATCHED,
+                                "Проверка пожелания дала подтверждённый результат.",
+                                retained,
+                                None,
+                            )
+        except (TimeoutError, ModelFailure) as error:
+            status = (
+                WishStatus.UNAVAILABLE if isinstance(error, ModelFailure) else WishStatus.INCOMPLETE
+            )
+            reason = "Проверка пожелания прервана из-за недоступности модели или истечения времени. Отсутствие результата не доказывает отсутствие свойства."
+            self._logger.warning("wish_agent_unavailable", wish=term, cause=type(error).__name__)
+        return completion.finish(status, reason, retained, question)
