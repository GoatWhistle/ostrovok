+++ b/backend/src/hotel_agent/application/agent/provider_content.py
@@ -0,0 +1,107 @@
+import json
+from collections.abc import Callable, Sequence
+from typing import Any
+
+from hotel_agent.application.dto import SearchHotelRecord
+from hotel_agent.application.ports.hotel_catalog import CatalogProviderFailure, HotelCatalogSource
+from hotel_agent.application.ports.repositories import UnitOfWorkFactory
+
+
+class ProviderContent:
+    def __init__(
+        self,
+        source: HotelCatalogSource | None,
+        uow: UnitOfWorkFactory,
+        hotels: Callable[[], Sequence[SearchHotelRecord]],
+    ) -> None:
+        self._source, self._uow, self._hotels = source, uow, hotels
+        self.hotels: list[dict[str, Any]] = []
+        self.rooms: list[dict[str, Any]] = []
+        self._checked: dict[str, str] = {}
+
+    async def read(self, hotel_ids: Sequence[str]) -> dict[str, Any]:
+        if self._source is None:
+            return {
+                "unavailable": True,
+                "error": "Provider content is not configured",
+                "missing_room_hotel_ids": list(hotel_ids),
+            }
+        selected = [hotel for hotel in self._hotels() if hotel.id in hotel_ids][:4]
+        if not selected:
+            raise ValueError("Select 1–4 hotel_ids from the candidates")
+        results = []
+        for hotel in selected:
+            if hotel.id in self._checked:
+                results.append(
+                    {"hotel_id": hotel.id, "status": self._checked[hotel.id], "cached": True}
+                )
+                continue
+            async with self._uow() as uow:
+                supplier_id = await uow.search.get_supplier_id(hotel.id, "nuitee")
+            status = "unmapped"
+            if supplier_id is not None:
+                try:
+                    catalog = await self._source.get_hotel(supplier_id)
+                except CatalogProviderFailure:
+                    status = "unavailable"
+                else:
+                    status = "available"
+                    source_url = "https://api.liteapi.travel/v3.0/data/hotel?hotelId=" + supplier_id
+                    identity = {
+                        "hotel_id": hotel.id,
+                        "hotel_name": hotel.name,
+                        "hotel_address": hotel.address,
+                        "hotel_location": hotel.location,
+                        "source_url": source_url,
+                        "source": "Nuitee",
+                    }
+                    self.hotels.append(
+                        {
+                            **identity,
+                            "id": supplier_id,
+                            "text": json.dumps(
+                                {
+                                    "name": catalog.name,
+                                    "facilities_ru": catalog.facilities_ru,
+                                    "facilities_en": catalog.facilities_en,
+                                    "details": catalog.details,
+                                },
+                                ensure_ascii=False,
+                            ),
+                        }
+                    )
+                    self.rooms.extend(
+                        {
+                            **identity,
+                            "id": room.supplier_id,
+                            "name": room.name,
+                            "capacity": room.max_adults,
+                            "amenities": list(room.amenities),
+                            "details": room.details,
+                            "text": json.dumps(
+                                {
+                                    "name": room.name,
+                                    "capacity": room.max_adults,
+                                    "amenities": room.amenities,
+                                    "details": room.details,
+                                },
+                                ensure_ascii=False,
+                            ),
+                        }
+                        for room in catalog.rooms
+                    )
+            self._checked[hotel.id] = status
+            results.append({"hotel_id": hotel.id, "status": status})
+        return {
+            "source": "provider",
+            "missing_room_hotel_ids": [
+                row["hotel_id"]
+                for row in results
+                if not any(room["hotel_id"] == row["hotel_id"] for room in self.rooms)
+            ],
+            "unavailable": bool(results) and all(row["status"] == "unavailable" for row in results),
+            "hotels": results,
+            "hotel_record_count": len(self.hotels),
+            "room_record_count": len(self.rooms),
+            "note": "Read provider_hotels/provider_rooms with match_records. Catalog does not establish dated availability.",
+        }
diff --git a/backend/src/hotel_agent/application/agent/recommendation_review.py b/backend/src/hotel_agent/application/agent/recommendation_review.py
new file mode 100644
index 0000000..1f6ab47
--- /dev/null
+++ b/backend/src/hotel_agent/application/agent/recommendation_review.py
@@ -0,0 +1,115 @@
+import json
+from collections.abc import Mapping, Sequence
+
+from hotel_agent.application.agent.semantic_review import ReviewClaim, ReviewResult, SemanticReview
+from hotel_agent.application.dto import SearchHotelRecord
+from hotel_agent.domain.entities import Fact
+from hotel_agent.domain.query import ParsedQuery
+from hotel_agent.domain.services.scoring import COUNTED_QUALITIES, MatchQuality, Scored
+
+
+def fact_evidence(fact: Fact | None) -> dict[str, object] | None:
+    if fact is None:
+        return None
+    return {
+        "id": str(fact.id),
+        "value": dict(fact.value) if isinstance(fact.value, Mapping) else fact.value,
+        "unit": fact.unit,
+        "qualifiers": dict(fact.qualifiers),
+        "explanation": fact.explanation,
+        "source_type": str(fact.provenance.source_type),
+        "source_id": fact.provenance.source.ref,
+        "method": fact.provenance.method,
+        "confidence": fact.provenance.confidence.value,
+        "computed_at": fact.provenance.computed_at.isoformat(),
+        "valid_until": fact.provenance.valid_until.isoformat()
+        if fact.provenance.valid_until
+        else None,
+    }
+
+
+def recommendation_claim(
+    hotel: SearchHotelRecord, scored: Scored, parsed: ParsedQuery
+) -> ReviewClaim:
+    claims = [
+        {
+            "wish": match.intent.source_text,
+            "quality": str(match.quality),
+            "explanation": match.fact.explanation if match.fact else "Нет подтверждённого факта",
+            "guaranteed": match.quality is MatchQuality.FULL,
+        }
+        for match in scored.matches
+    ]
+    evidence = {
+        "hotel": {
+            "id": hotel.id,
+            "name": hotel.name,
+            "region_id": hotel.region_id,
+            "location": hotel.location,
+            "address": hotel.address,
+            "stars": hotel.stars,
+            "height_m": hotel.height_m,
+            "levels": hotel.levels,
+        },
+        "facts": [
+            {
+                "wish": match.intent.source_text,
+                "quality": str(match.quality),
+                "fact": fact_evidence(match.fact),
+            }
+            for match in scored.matches
+        ],
+        "unverified_wishes": list(parsed.unmatched_terms),
+        "stay": {
+            "check_in": str(parsed.check_in) if parsed.check_in else None,
+            "check_out": str(parsed.check_out) if parsed.check_out else None,
+            "adults": parsed.adults,
+            "budget": parsed.budget,
+        },
+    }
+    answer = {
+        "recommended_hotel_id": hotel.id,
+        "matches": claims,
+        "all_conditions_verified": bool(scored.matches)
+        and all(item.quality is MatchQuality.FULL for item in scored.matches)
+        and not parsed.unmatched_terms,
+    }
+    return ReviewClaim(
+        hotel.id, json.dumps(answer, ensure_ascii=False), json.dumps(evidence, ensure_ascii=False)
+    )
+
+
+class RecommendationReview:
+    def __init__(self, review: SemanticReview, max_candidates: int = 60) -> None:
+        self._review, self._max_candidates = review, max_candidates
+
+    async def check(
+        self,
+        query: str,
+        parsed: ParsedQuery,
+        candidates: Sequence[tuple[SearchHotelRecord, Scored]],
+        limit: int,
+    ) -> ReviewResult:
+        accepted: list[str] = []
+        rejected: list[str] = []
+        eligible = []
+        for hotel, scored in candidates:
+            if (parsed.intents or parsed.unmatched_terms or parsed.wishes) and not any(
+                item.quality in COUNTED_QUALITIES for item in scored.matches
+            ):
+                rejected.append(hotel.id)
+            else:
+                eligible.append((hotel, scored))
+        candidates = eligible
+        for offset in range(0, min(len(candidates), self._max_candidates), 12):
+            batch = candidates[offset : min(offset + 12, self._max_candidates)]
+            report = await self._review.check(
+                query,
+                "recommendation_scope",
+                [recommendation_claim(hotel, scored, parsed) for hotel, scored in batch],
+            )
+            accepted.extend(report.accepted_ids)
+            rejected.extend(report.rejected_ids)
+            if report.unavailable or len(accepted) >= limit:
+                return ReviewResult(tuple(accepted), tuple(rejected), report.unavailable)
+        return ReviewResult(tuple(accepted), tuple(rejected))
