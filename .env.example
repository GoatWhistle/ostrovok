COMPOSE_PROJECT_NAME=hotel-agent
TAG=latest
SITE_URL=
FRONTEND_PORT=8080
API_UPSTREAM=http://backend:8000
API_URL=http://localhost:8000
API_SCHEMA_URL=http://localhost:8000/openapi.json
BACKEND_PORT=8000
POSTGRES_USER=hotel
POSTGRES_PASSWORD=hotel
POSTGRES_DB=hotel
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hotel:hotel@localhost:5432/hotel
CHARACTERISTICS_DIR=characteristics
SEED_DIR=data/seed
LLM_PROVIDER=fake
LLM_API_KEY=
# Yandex Cloud AI Studio: https://llm.api.cloud.yandex.net/v1
# Anthropic: https://api.anthropic.com/v1 (default with LLM_PROVIDER=anthropic)
LLM_BASE_URL=
# Yandex Cloud AI Studio: gpt://<folder_id>/yandexgpt-5.1/latest
# Anthropic: claude-sonnet-4-6
LLM_MODEL=
LLM_FALLBACK_MODEL=
# Optional: a faster model for tool-planning steps; the main model stays the second attempt
LLM_PLANNING_MODEL=
# Optional: a faster model for final reviews; its approvals stand, its rejections are re-checked
# by LLM_MODEL. Empty means LLM_PLANNING_MODEL; set it equal to LLM_MODEL to disable
LLM_REVIEW_MODEL=
LLM_TIMEOUT_S=30
ETG_KEY_ID=
ETG_API_KEY=
ETG_ENVIRONMENT=sandbox
NUITEE_API_KEY=
HOTEL_DATA_MODE=free
OSTROVOK_SITE=on

EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_BASE_URL=https://polza.ai/api/v1

TERRAIN_CACHE_DIR=

PUBLIC_DATA_USER_AGENT=HotelAgent/0.1 (https://github.com/GoatWhistle/o-hack)
GEOGRAPHY_API_URL=https://overpass.private.coffee/api/interpreter

# Folder with large regional basemaps (make fetch-basemap-russia); Sochi works without it
MAP_BASEMAPS_HOST_DIR=./data/basemaps
