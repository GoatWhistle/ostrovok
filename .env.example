# Все значения пустые. В комментарии указано, откуда взять значение или какое значение по умолчанию.
# Реальные значения лежат в зашифрованном secrets.env.age (age, ключ организаторов).

# Имя проекта Docker Compose, по умолчанию: hotel-agent
COMPOSE_PROJECT_NAME=
# Тег образов docker buildx bake, по умолчанию: latest
TAG=
# Публичный адрес сайта для ссылок и карточек соцсетей, можно оставить пустым
SITE_URL=
# Порт фронтенда на хосте, по умолчанию: 8080
FRONTEND_PORT=
# Адрес бэкенда для nginx внутри Compose, по умолчанию: http://backend:8000
API_UPSTREAM=
# Адрес бэкенда для dev-сервера Vite, по умолчанию: http://localhost:8000
API_URL=
# Схема OpenAPI для генерации типов фронтенда, по умолчанию: http://localhost:8000/openapi.json
API_SCHEMA_URL=
# Порт бэкенда на хосте, по умолчанию: 8000
BACKEND_PORT=

# PostgreSQL/PostGIS стенда, по умолчанию: hotel / hotel / hotel / 5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# Строка подключения для локального запуска бэкенда вне Compose,
# по умолчанию: postgresql://hotel:hotel@localhost:5432/hotel
DATABASE_URL=
# Каталог характеристик, по умолчанию: characteristics
CHARACTERISTICS_DIR=
# Каталог сид-данных, по умолчанию: data/seed
SEED_DIR=

# Провайдер LLM: openai_compat (живая модель), anthropic или fake (офлайн-разбор без ключа)
LLM_PROVIDER=
# Ключ провайдера LLM. Для жюри выдан отдельный ключ, основной ключ не передаётся
LLM_API_KEY=
# Адрес OpenAI-совместимого API провайдера
# Yandex Cloud AI Studio: https://llm.api.cloud.yandex.net/v1
# Anthropic: https://api.anthropic.com/v1 (по умолчанию при LLM_PROVIDER=anthropic)
LLM_BASE_URL=
# Основная модель, например gpt://<folder_id>/yandexgpt-5.1/latest или claude-sonnet-4-6
LLM_MODEL=
# Запасная модель, когда основная не отвечает
LLM_FALLBACK_MODEL=
# Необязательно: быстрая модель для шагов планирования; основная остаётся второй попыткой
LLM_PLANNING_MODEL=
# Необязательно: быстрая модель для итоговой проверки; её одобрения окончательны,
# отказы перепроверяет LLM_MODEL. Пусто значит LLM_PLANNING_MODEL
LLM_REVIEW_MODEL=
# Таймаут одного вызова LLM в секундах, по умолчанию: 30
LLM_TIMEOUT_S=
# Ключ Anthropic, если LLM_PROVIDER=anthropic: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Ключ Yandex Cloud AI Studio: https://console.yandex.cloud
YANDEX_API_KEY=

# ETG/Ostrovok B2B API (необязательно): https://www.ratehawk.com/lp/en-us/API/
ETG_KEY_ID=
ETG_API_KEY=
# Окружение ETG: sandbox или production, по умолчанию: sandbox
ETG_ENVIRONMENT=
# Ключ Nuitee (необязательно)
NUITEE_API_KEY=
# Режим данных об отелях: free (публичные источники) или api, по умолчанию: free
HOTEL_DATA_MODE=
# Публичная страница отеля на Островке как источник: on или off, по умолчанию: on
OSTROVOK_SITE=

# Провайдер эмбеддингов, по умолчанию берётся из EMBEDDING_BASE_URL
EMBEDDING_PROVIDER=
# Ключ сервиса эмбеддингов (OpenAI-совместимый API)
EMBEDDING_API_KEY=
# Модель эмбеддингов, по умолчанию: qwen/qwen3-embedding-8b
EMBEDDING_MODEL=
# Адрес API эмбеддингов, по умолчанию: https://polza.ai/api/v1
EMBEDDING_BASE_URL=

# Каталог кэша тайлов рельефа, пусто значит том Compose
TERRAIN_CACHE_DIR=
# User-Agent для запросов к публичным данным (OSM, Overpass), по умолчанию: HotelAgent/0.1
PUBLIC_DATA_USER_AGENT=
# Overpass API, по умолчанию: https://overpass.private.coffee/api/interpreter
GEOGRAPHY_API_URL=

# Секрет для подписанных ссылок отельеру с одним вопросом (любая длинная случайная строка).
# Без него GET /api/v1/hotelier/questions/{id} отвечает 503, кабинет работает
QUESTION_LINK_SECRET=

# Папка с крупными региональными подложками (make fetch-basemap-russia); Сочи работает без неё,
# по умолчанию: ./data/basemaps
MAP_BASEMAPS_HOST_DIR=
